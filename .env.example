# 공공데이터포털(data.go.kr)에서 발급받은 심평원 Open API 서비스키(Decoding 키 권장)를 입력하세요.
# https://www.data.go.kr 에서 "건강보험심사평가원_병원정보서비스" 등을 신청하면 발급됩니다.
HIRA_SERVICE_KEY=

# 서비스키 없이 화면/기능을 확인해보고 싶을 때 true로 설정하세요.
# HIRA_SERVICE_KEY가 비어 있으면 자동으로 mock 모드로 동작하므로, 보통은 설정할 필요가 없습니다.
# HIRA_USE_MOCK=true

# 건강보험심사평가원_의약품사용정보조회서비스 (data.go.kr 15047819)
# 이 API는 오퍼레이션이 12개이고 정확한 End Point/오퍼레이션명을 문서로 확인하지
# 못해, 아래 두 값을 직접 채워야만 실제 데이터로 연동됩니다(비워두면 항상 샘플
# 데이터). data.go.kr에서 해당 데이터셋 페이지 > "활용신청 상세기능정보"에서
# End Point와 사용할 오퍼레이션명을 확인해 넣어주세요.
# HIRA_DRUG_USAGE_BASE_URL=http://apis.data.go.kr/B551182/실제서비스경로
# HIRA_DRUG_USAGE_OPERATION=실제오퍼레이션명
